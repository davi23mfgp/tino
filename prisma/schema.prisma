// ============================================================
// Tino — contador pessoal para PF (solo, casal, família) e MEI.
// Multi-tenant por lar (Lar). Dinheiro sempre em centavos (Int):
// float em dinheiro acumula erro de arredondamento e o extrato deixa de fechar.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Em produção o Postgres gerenciado (Neon, Supabase) fica atrás de um pooler:
  // as consultas do app vão pela URL com pool, mas migration precisa de conexão
  // direta — pooler não aceita os comandos de DDL que o migrate emite.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TipoLar {
  SOLO
  CASAL
  FAMILIA
}

enum PapelMembro {
  TITULAR
  CONJUGE
  DEPENDENTE
  CONVIDADO // vê, não edita (ex.: contador externo)
  /// Login próprio, mas só abre /loja — ver src/lib/acesso.ts e
  /// docs/TINO-MEI.md, Fase 7. Não é dono nem enxerga a vida pessoal do lar.
  FUNCIONARIO_LOJA
}

enum TipoConta {
  CORRENTE
  POUPANCA
  CARTAO_CREDITO
  DINHEIRO
  INVESTIMENTO
  PJ_MEI // conta separada do CNPJ: misturar PF e PJ é o erro nº 1 do MEI
}

enum TipoTransacao {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum OrigemTransacao {
  MANUAL
  IMPORT_OFX
  IMPORT_CSV
  IMPORT_PDF
  OPEN_FINANCE
  RECORRENCIA
}

enum GrupoCategoria {
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  EDUCACAO
  LAZER
  PESSOAL
  SERVICOS
  DIVIDAS
  IMPOSTOS
  INVESTIMENTO
  RENDA
  NEGOCIO_MEI
  OUTROS
}

enum Periodicidade {
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoMeta {
  RESERVA_EMERGENCIA
  VIAGEM
  APOSENTADORIA
  IMOVEL
  VEICULO
  EDUCACAO
  QUITAR_DIVIDA
  OUTRO
}

enum StatusMeta {
  ATIVA
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum TipoDivida {
  CARTAO_ROTATIVO
  CHEQUE_ESPECIAL
  EMPRESTIMO_PESSOAL
  CONSIGNADO
  FINANCIAMENTO_VEICULO
  FINANCIAMENTO_IMOVEL
  ESTUDANTIL
  PARCELAMENTO
  OUTRO
}

enum EstrategiaDivida {
  AVALANCHE // maior juros primeiro — paga menos no total
  BOLA_DE_NEVE // menor saldo primeiro — vitória rápida, mantém a pessoa no plano
  PROPORCIONAL
}

enum AtividadeMei {
  COMERCIO
  INDUSTRIA
  SERVICOS
  COMERCIO_E_SERVICOS
  TRANSPORTE_CARGA // limite próprio, maior
}

enum StatusConexao {
  ATIVA
  EXPIRADA
  ERRO
  REVOGADA
}

enum SeveridadeAlerta {
  INFO
  ATENCAO
  CRITICO
}

enum PapelMensagem {
  USUARIO
  ASSISTENTE
}

enum ProvedorPagamento {
  MERCADO_PAGO
  STRIPE
}

/// Estados possíveis de uma assinatura, iguais para os dois gateways.
///
/// Traduzir o vocabulário de cada provedor na borda é o que impede o resto do
/// app de saber que existe "authorized" no Mercado Pago e "past_due" no Stripe.
enum StatusAssinatura {
  /// Período de teste, sem cobrança feita ainda.
  TESTE
  /// Checkout iniciado, aguardando o provedor confirmar o primeiro pagamento.
  PENDENTE
  ATIVA
  /// Cobrança falhou e o provedor ainda está tentando. Não é cancelamento.
  INADIMPLENTE
  CANCELADA
}

enum CicloCobranca {
  MENSAL
  ANUAL
}

enum StatusCobranca {
  PENDENTE
  PAGA
  FALHOU
  ESTORNADA
}

enum TipoChamado {
  BUG
  DUVIDA
  COBRANCA
}

enum StatusChamado {
  ABERTO
  RESOLVIDO
}

enum OrigemCaptura {
  NOTIFICACAO // aviso de compra do app do banco, repassado pelo celular
  TELEGRAM // mensagem ou arquivo enviado ao bot
  ATALHO // atalho do iOS / widget
  /// Folha de compartilhamento do Android: a pessoa tocou em "Compartilhar" no
  /// app do banco e escolheu o Tino. Separado de ATALHO porque o texto chega
  /// diferente — vem do app de origem, não de um modelo escrito pela pessoa — e
  /// é olhando a origem que dá para melhorar o leitor depois.
  COMPARTILHAMENTO
  EMAIL
  MANUAL
}

enum StatusCaptura {
  PENDENTE // esperando você confirmar
  CONFIRMADA
  DESCARTADA
  /// Não deu para entender o texto: fica guardado para você ver o que chegou.
  NAO_ENTENDIDA
}

// ============================================================
// LAR E PESSOAS
// ============================================================

model Lar {
  id          String  @id @default(cuid())
  nome        String
  tipo        TipoLar @default(SOLO)
  moeda       String  @default("BRL")
  fusoHorario String  @default("America/Sao_Paulo")

  // Dia em que o "mês financeiro" vira. Quem recebe dia 5 não pensa em
  // 1º a 31 — o orçamento dele começa no dia do salário.
  diaInicioMes Int @default(1)

  estrategiaDivida EstrategiaDivida @default(AVALANCHE)
  // Meses de custo fixo que a reserva de emergência deve cobrir.
  mesesReserva     Int              @default(6)

  /// Marca quando o usuário terminou a conversa inicial. Enquanto for null, o
  /// app leva para o /bem-vindo em vez de mostrar um painel vazio.
  onboardingEm DateTime?

  /// Gasto mensal que o usuário estimou na conversa inicial. É a referência de
  /// custo de vida enquanto não houver histórico lançado — sem ela, o app
  /// calcularia uma sobra que não existe e prometeria quitação rápida demais.
  custoEstimadoCentavos Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  membros         Membro[]
  usuarios        Usuario[]
  contas          Conta[]
  categorias      Categoria[]
  transacoes      Transacao[]
  regras          RegraCategorizacao[]
  recorrencias    Recorrencia[]
  orcamentos      Orcamento[]
  metas           Meta[]
  dividas         Divida[]
  simulacoes      SimulacaoEmprestimo[]
  faturas         Fatura[]
  importacoes     Importacao[]
  conexoes        ConexaoOpenFinance[]
  alertas         Alerta[]
  vigiaConfigs    VigiaConfig[]
  conversas       Conversa[]
  meiPerfil       MeiPerfil?
  meiCompetencias MeiCompetencia[]
  parcelamentos   Parcelamento[]
  capturas        Captura[]
  chavesCaptura   ChaveCaptura[]
  lojas           Loja[]
}

model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  senhaHash    String
  nome         String
  avatarUrl    String?
  larId        String
  lar          Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  membroId     String?   @unique
  membro       Membro?   @relation(fields: [membroId], references: [id])
  ultimoLogin  DateTime?

  /// Acesso ao painel de administração do produto.
  ///
  /// É um papel na mesma conta, não um login separado: dois sistemas de sessão
  /// dobram a superfície de ataque e o dono acabaria com duas senhas para a
  /// mesma pessoa. Só se liga por comando no banco — não existe tela que
  /// promova ninguém, justamente para não haver escalada de privilégio por bug
  /// de rota.
  admin Boolean @default(false)

  /// Como esta pessoa deixou o Tino: cor do corpo e acessório.
  ///
  /// Fica no usuário e não no lar porque é escolha de gosto, e duas pessoas do
  /// mesmo lar podem querer coisas diferentes. O que elas NÃO escolhem é a
  /// expressão dele — essa vem do motor de alertas e é a mesma para as duas,
  /// porque as contas são as mesmas.
  tinoCor       String @default("grafite")
  tinoAcessorio String @default("nenhum")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  conversas  Conversa[]
  assinatura Assinatura?
  chamados   Chamado[]

  @@index([larId])
}

/// Pessoa dentro do lar. Nem todo membro faz login (filho, dependente),
/// por isso Membro é separado de Usuario.
model Membro {
  id                  String      @id @default(cuid())
  larId               String
  lar                 Lar         @relation(fields: [larId], references: [id], onDelete: Cascade)
  nome                String
  papel               PapelMembro @default(TITULAR)
  cor                 String      @default("blue")
  rendaMensalCentavos Int         @default(0)
  criadoEm            DateTime    @default(now())

  usuario    Usuario?
  contas     Conta[]
  transacoes Transacao[]
  regras     RegraCategorizacao[]

  @@index([larId])
}

// ============================================================
// CONTAS E LANÇAMENTOS
// ============================================================

model Conta {
  id                   String    @id @default(cuid())
  larId                String
  lar                  Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  membroId             String?
  membro               Membro?   @relation(fields: [membroId], references: [id])
  nome                 String
  instituicao          String?
  tipo                 TipoConta @default(CORRENTE)
  saldoInicialCentavos Int       @default(0)
  cor                  String    @default("blue")
  arquivada            Boolean   @default(false)

  // Cartão de crédito
  limiteCentavos Int?
  diaFechamento  Int?
  diaVencimento  Int?

  conexaoId      String?
  conexao        ConexaoOpenFinance? @relation(fields: [conexaoId], references: [id])
  contaExternaId String? // id da conta no agregador

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  transacoes    Transacao[]
  faturas       Fatura[]
  metas         Meta[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]
  dividas       Divida[]

  @@index([larId])
}

model Categoria {
  id    String         @id @default(cuid())
  larId String
  lar   Lar            @relation(fields: [larId], references: [id], onDelete: Cascade)
  nome  String
  grupo GrupoCategoria @default(OUTROS)
  tipo  TipoTransacao  @default(DESPESA)
  cor   String         @default("blue")
  icone String         @default("circle")

  /// Essencial = corta por último. Base do plano de corte e do cálculo da reserva.
  essencial Boolean @default(false)

  /// Categoria criada pelo seed: não pode ser apagada, só renomeada.
  sistema Boolean     @default(false)
  paiId   String?
  pai     Categoria?  @relation("Subcategoria", fields: [paiId], references: [id])
  filhas  Categoria[] @relation("Subcategoria")
  ordem   Int         @default(0)

  transacoes    Transacao[]
  regras        RegraCategorizacao[]
  orcamentos    Orcamento[]
  recorrencias  Recorrencia[]
  parcelamentos Parcelamento[]

  @@unique([larId, nome, paiId])
  @@index([larId])
}

model Transacao {
  id          String     @id @default(cuid())
  larId       String
  lar         Lar        @relation(fields: [larId], references: [id], onDelete: Cascade)
  contaId     String
  conta       Conta      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  membroId    String?
  membro      Membro?    @relation(fields: [membroId], references: [id])

  data      DateTime
  descricao String

  /// Texto cru do extrato. Guardado para reprocessar regras sem perder o original.
  descricaoOriginal String?

  /// Sempre positivo. O sinal vem de `tipo` — valor negativo em banco vira
  /// soma errada assim que alguém esquece o Math.abs.
  valorCentavos Int
  tipo          TipoTransacao
  pago          Boolean         @default(true)
  origem        OrigemTransacao @default(MANUAL)
  observacao    String?
  tags          String[]        @default([])

  /// Competência (YYYY-MM) — separa quando gastou de quando pagou.
  competencia String

  transferenciaParId String?    @unique
  transferenciaPar   Transacao? @relation("ParTransferencia", fields: [transferenciaParId], references: [id])
  transferenciaDe    Transacao? @relation("ParTransferencia")

  faturaId String?
  fatura   Fatura? @relation(fields: [faturaId], references: [id])

  metaId String?
  meta   Meta?   @relation(fields: [metaId], references: [id])

  dividaId String?
  divida   Divida? @relation(fields: [dividaId], references: [id])

  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id])

  importacaoId String?
  importacao   Importacao? @relation(fields: [importacaoId], references: [id])

  /// Impressão digital do lançamento (conta+data+valor+descrição).
  /// Único por lar: reimportar o mesmo extrato não duplica nada.
  hashImport         String?
  transacaoExternaId String?

  /// MEI: marca que o lançamento entra no faturamento do CNPJ.
  meiFaturamento Boolean @default(false)
  notaFiscal     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([larId, hashImport])
  @@index([larId, data])
  @@index([larId, competencia])
  @@index([contaId, data])
  @@index([categoriaId])
}

/// Regra de categorização automática. Roda na importação e no reprocessamento.
model RegraCategorizacao {
  id    String @id @default(cuid())
  larId String
  lar   Lar    @relation(fields: [larId], references: [id], onDelete: Cascade)

  /// Trecho procurado na descrição (case-insensitive) ou regex se `regex` = true.
  padrao      String
  regex       Boolean   @default(false)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  membroId    String?
  membro      Membro?   @relation(fields: [membroId], references: [id])

  /// Renomeia o lançamento ("PAG*IFOOD 33" -> "iFood").
  renomearPara String?
  tags         String[] @default([])

  /// Maior prioridade vence. Regra aprendida do usuário nasce acima das do seed.
  prioridade Int     @default(0)
  ativa      Boolean @default(true)

  /// Quantas vezes já pegou — mostra ao usuário o que a regra está fazendo.
  acertos  Int      @default(0)
  criadoEm DateTime @default(now())

  @@index([larId])
}

model Fatura {
  id            String    @id @default(cuid())
  larId         String
  lar           Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  contaId       String
  conta         Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  competencia   String // YYYY-MM
  fechamento    DateTime
  vencimento    DateTime
  totalCentavos Int       @default(0)
  paga          Boolean   @default(false)
  pagaEm        DateTime?

  transacoes Transacao[]

  @@unique([contaId, competencia])
  @@index([larId])
}

model Recorrencia {
  id            String        @id @default(cuid())
  larId         String
  lar           Lar           @relation(fields: [larId], references: [id], onDelete: Cascade)
  descricao     String
  valorCentavos Int
  tipo          TipoTransacao
  periodicidade Periodicidade @default(MENSAL)
  diaVencimento Int
  proximaData   DateTime
  fimEm         DateTime?
  contaId       String
  conta         Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  categoriaId   String?
  categoria     Categoria?    @relation(fields: [categoriaId], references: [id])

  /// Valor muda todo mês (luz, água): entra na projeção pela média, não pelo fixo.
  valorVariavel Boolean  @default(false)
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  transacoes Transacao[]

  @@index([larId])
}

model Orcamento {
  id             String    @id @default(cuid())
  larId          String
  lar            Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  competencia    String // YYYY-MM
  categoriaId    String
  categoria      Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  limiteCentavos Int

  @@unique([larId, competencia, categoriaId])
  @@index([larId, competencia])
}

// ============================================================
// METAS E DÍVIDAS
// ============================================================

model Meta {
  id                   String    @id @default(cuid())
  larId                String
  lar                  Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  nome                 String
  tipo                 TipoMeta  @default(OUTRO)
  alvoCentavos         Int
  saldoCentavos        Int       @default(0)
  dataAlvo             DateTime?
  aporteMensalCentavos Int       @default(0)

  /// Rendimento anual esperado, em pontos-base (1200 = 12,00% a.a.).
  /// Inteiro evita o float na projeção composta.
  rendimentoAnualBps Int        @default(0)
  prioridade         Int        @default(0)
  status             StatusMeta @default(ATIVA)
  cor                String     @default("blue")
  icone              String     @default("target")
  contaId            String?
  conta              Conta?     @relation(fields: [contaId], references: [id])
  observacao         String?
  criadoEm           DateTime   @default(now())
  atualizadoEm       DateTime   @updatedAt

  transacoes Transacao[]

  @@index([larId])
}

model Divida {
  id    String @id @default(cuid())
  larId String
  lar   Lar    @relation(fields: [larId], references: [id], onDelete: Cascade)

  /// Conta que originou a dívida (cheque especial de uma conta corrente).
  /// Com o vínculo, o plano de pagamento sabe que o saldo negativo daquela
  /// conta e esta dívida são a mesma coisa, e não conta o valor duas vezes.
  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  credor               String
  tipo                 TipoDivida @default(OUTRO)
  saldoDevedorCentavos Int

  /// Juros ao mês em pontos-base (250 = 2,50% a.m.).
  jurosMensalBps  Int       @default(0)
  parcelaCentavos Int       @default(0)
  parcelasTotal   Int?
  parcelasPagas   Int       @default(0)
  diaVencimento   Int       @default(10)
  quitada         Boolean   @default(false)
  quitadaEm       DateTime?
  observacao      String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  transacoes Transacao[]

  @@index([larId])
}

/// Compra parcelada no cartão.
///
/// Fica separada de `Divida` porque o comportamento é outro: não tem juro
/// declarado, não se "quita antecipado" da mesma forma, e o que importa é
/// quanto dela cai em cada fatura futura. É esse valor que trava o orçamento
/// dos próximos meses sem aparecer em lugar nenhum do extrato de hoje.
model Parcelamento {
  id              String     @id @default(cuid())
  larId           String
  lar             Lar        @relation(fields: [larId], references: [id], onDelete: Cascade)
  contaId         String
  conta           Conta      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  descricao       String
  estabelecimento String?
  categoriaId     String?
  categoria       Categoria? @relation(fields: [categoriaId], references: [id])

  valorTotalCentavos  Int
  parcelaCentavos     Int
  parcelasTotal       Int
  parcelasPagas       Int      @default(0)
  dataCompra          DateTime
  /// Competência da primeira parcela (YYYY-MM). Todas as outras saem daqui.
  primeiraCompetencia String

  ativo        Boolean         @default(true)
  origem       OrigemTransacao @default(MANUAL)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  parcelas ParcelaCompra[]

  @@index([larId])
  @@index([contaId])
}

model ParcelaCompra {
  id             String       @id @default(cuid())
  parcelamentoId String
  parcelamento   Parcelamento @relation(fields: [parcelamentoId], references: [id], onDelete: Cascade)
  numero         Int
  competencia    String // YYYY-MM da fatura em que cai
  vencimento     DateTime
  valorCentavos  Int
  paga           Boolean      @default(false)
  pagaEm         DateTime?

  @@unique([parcelamentoId, numero])
  @@index([competencia])
}

model SimulacaoEmprestimo {
  id            String @id @default(cuid())
  larId         String
  lar           Lar    @relation(fields: [larId], references: [id], onDelete: Cascade)
  titulo        String
  valorCentavos Int
  parcelas      Int

  /// Taxa nominal informada pelo banco, ao mês, em pontos-base.
  jurosMensalBps Int

  /// Custos que o banco não põe na "taxa": IOF, tarifa, seguro.
  custosExtrasCentavos Int @default(0)

  /// Resultado calculado: parcela, CET, total pago, comprometimento de renda.
  resultado Json

  /// Veredito do Tino: APROVAR / CUIDADO / EVITAR + motivos.
  veredito String?
  criadoEm DateTime @default(now())

  @@index([larId])
}

// ============================================================
// MEI
// ============================================================

model MeiPerfil {
  id           String       @id @default(cuid())
  larId        String       @unique
  lar          Lar          @relation(fields: [larId], references: [id], onDelete: Cascade)
  cnpj         String?
  razaoSocial  String?
  atividade    AtividadeMei @default(SERVICOS)
  dataAbertura DateTime?

  /// Limite anual de faturamento em centavos. Guardado no perfil (não no código)
  /// porque muda por lei e por atividade — transportador de carga tem outro.
  limiteAnualCentavos Int @default(8100000)

  /// Valor do DAS mensal em centavos — muda todo ano com o salário mínimo.
  dasMensalCentavos Int @default(7580)
  diaVencimentoDas  Int @default(20)

  /// Pró-labore: quanto o MEI transfere do CNPJ para a PF todo mês.
  proLaboreCentavos Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model MeiCompetencia {
  id                      String    @id @default(cuid())
  larId                   String
  lar                     Lar       @relation(fields: [larId], references: [id], onDelete: Cascade)
  competencia             String // YYYY-MM
  receitaComercioCentavos Int       @default(0)
  receitaServicosCentavos Int       @default(0)
  dasPago                 Boolean   @default(false)
  dasPagoEm               DateTime?
  dasValorCentavos        Int       @default(0)
  observacao              String?

  @@unique([larId, competencia])
  @@index([larId])
}

// ============================================================
// IMPORTAÇÃO E OPEN FINANCE
// ============================================================

model Importacao {
  id          String   @id @default(cuid())
  larId       String
  lar         Lar      @relation(fields: [larId], references: [id], onDelete: Cascade)
  contaId     String?
  arquivoNome String
  formato     String // ofx | csv | pdf
  totalLinhas Int      @default(0)
  importadas  Int      @default(0)
  duplicadas  Int      @default(0)
  erros       Int      @default(0)
  detalhes    Json?
  criadoEm    DateTime @default(now())

  transacoes Transacao[]

  @@index([larId])
}

model ConexaoOpenFinance {
  id          String        @id @default(cuid())
  larId       String
  lar         Lar           @relation(fields: [larId], references: [id], onDelete: Cascade)
  provedor    String // pluggy | belvo | sandbox
  itemId      String
  instituicao String
  status      StatusConexao @default(ATIVA)
  ultimaSync  DateTime?

  /// Consentimento de Open Finance expira (12 meses no padrão BCB).
  /// Sem esta data o app não avisa o usuário antes de a sincronização parar.
  consentimentoExpiraEm DateTime?
  erroMensagem          String?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  contas Conta[]

  @@unique([larId, provedor, itemId])
  @@index([larId])
}

// ============================================================
// ASSISTENTE — ALERTAS E CONVERSA
// ============================================================

model Alerta {
  id         String           @id @default(cuid())
  larId      String
  lar        Lar              @relation(fields: [larId], references: [id], onDelete: Cascade)
  tipo       String
  severidade SeveridadeAlerta @default(INFO)
  titulo     String
  texto      String
  acaoRota   String?
  dados      Json?
  lido       Boolean          @default(false)

  /// Chave estável do alerta no período — evita repetir o mesmo aviso todo dia.
  chave    String
  criadoEm DateTime @default(now())

  @@unique([larId, chave])
  @@index([larId, lido])
}

/// Liga/desliga por TIPO de alerta — os "vigias" do redesign de 07/09/2026.
/// Ausência de linha = ligado (o padrão é vigiar tudo); só existe registro
/// pra quem desligou algum. Isso poupa criar 6 linhas em branco por lar novo.
model VigiaConfig {
  id     String @id @default(cuid())
  larId  String
  lar    Lar    @relation(fields: [larId], references: [id], onDelete: Cascade)
  /// Mesmo valor de Alerta.tipo — não é enum porque um vigia novo não pode
  /// pedir migration pra existir, só uma linha na lista do motor.
  tipo   String
  ativo  Boolean @default(true)

  @@unique([larId, tipo])
}

model Conversa {
  id           String   @id @default(cuid())
  larId        String
  lar          Lar      @relation(fields: [larId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo       String   @default("Nova conversa")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  mensagens Mensagem[]

  @@index([larId])
}

model Mensagem {
  id         String        @id @default(cuid())
  conversaId String
  conversa   Conversa      @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  papel      PapelMensagem
  texto      String

  /// Números que o Tino usou para responder — a resposta fica auditável.
  contexto Json?
  criadoEm DateTime @default(now())

  @@index([conversaId])
}

// ============================================================
// CAPTURA RÁPIDA
// ============================================================

/// Chave de um canal de entrada (celular, bot do Telegram, atalho do iOS).
///
/// Fica separada da sessão de propósito: o celular manda lançamento o dia
/// inteiro em segundo plano, e obrigá-lo a manter login de navegador ativo
/// quebraria na primeira expiração de cookie. Uma chave por aparelho permite
/// revogar só o que foi perdido.
model ChaveCaptura {
  id        String        @id @default(cuid())
  larId     String
  lar       Lar           @relation(fields: [larId], references: [id], onDelete: Cascade)
  nome      String
  /// Hash da chave. O valor em claro é mostrado uma única vez, na criação —
  /// guardar o original permitiria a quem lesse o banco lançar em nome do dono.
  chaveHash String        @unique
  /// Últimos caracteres, só para o usuário reconhecer qual chave é qual.
  sufixo    String
  origem    OrigemCaptura @default(NOTIFICACAO)
  /// Identificador do chat do Telegram, quando o canal é o bot.
  chatId    String?
  ativa     Boolean       @default(true)
  ultimoUso DateTime?
  usos      Int           @default(0)
  criadoEm  DateTime      @default(now())

  capturas Captura[]

  @@index([larId])
}

/// Um lançamento que chegou de fora e ainda não virou transação.
///
/// Nada entra direto no extrato: notificação de banco erra (compra negada,
/// estorno, pré-autorização de posto) e um lançamento errado no meio do
/// histórico é pior que um lançamento faltando.
model Captura {
  id      String        @id @default(cuid())
  larId   String
  lar     Lar           @relation(fields: [larId], references: [id], onDelete: Cascade)
  chaveId String?
  chave   ChaveCaptura? @relation(fields: [chaveId], references: [id], onDelete: SetNull)

  origem     OrigemCaptura @default(NOTIFICACAO)
  status     StatusCaptura @default(PENDENTE)
  /// Texto exatamente como chegou. É a prova do que foi lido.
  textoBruto String

  valorCentavos   Int?
  estabelecimento String?
  data            DateTime?
  cartaoFinal     String?
  instituicao     String?
  /// Parcela detectada na notificação ("2/10").
  parcelaNumero   Int?
  parcelaTotal    Int?

  contaId     String?
  categoriaId String?
  /// 0 a 100 — abaixo de 70 a tela pede conferência antes de aceitar.
  confianca   Int     @default(0)

  transacaoId String?   @unique
  criadoEm    DateTime  @default(now())
  decididoEm  DateTime?

  @@index([larId, status])
}

// ============================================================
// TINO.MEI — LOJA
//
// Sistema de balcão para o MEI que tem loja em galeria ou shopping.
// Escopo e fases em docs/TINO-MEI.md e docs/TINO-MEI-FASES.md.
//
// Preso ao Lar como todo o resto: quem liga a loja é a mesma conta que já
// cuida do dinheiro pessoal, e é isso que deixa o app responder quanto do
// limite do MEI já foi usado sem ninguém redigitar faturamento.
// ============================================================

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO_VISTA
  CREDITO_PARCELADO
  FIADO
}

model Loja {
  id    String @id @default(cuid())
  larId String
  lar   Lar    @relation(fields: [larId], references: [id], onDelete: Cascade)

  nome     String
  /// Galeria, box, quiosque. Só para o dono se achar quando tiver mais de uma.
  endereco String?

  /// Dados fiscais, preenchidos só quando o lojista liga a emissão de nota.
  /// Sem eles a nota não sai — a tela de emissão pede antes de deixar tentar.
  cnpj              String?
  inscricaoEstadual String?
  /// Não é o certificado em si — isso não é guardado no nosso banco. Marca
  /// que o provedor de emissão confirmou o certificado configurado do lado
  /// dele, para a tela saber se já dá para tentar emitir.
  certificadoConfiguradoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos    ProdutoLoja[]
  vendas      VendaLoja[]
  caixas      Caixa[]
  recebimento FormaRecebimento[]
  clientes    ClienteLoja[]
  contas      ContaDaLoja[]

  @@index([larId])
}

/// Taxa e prazo de cada forma de pagamento, cadastrados uma vez.
///
/// É o que impede o app de dizer que a venda de R$ 100 no crédito virou R$ 100
/// hoje. A maquininha cobra taxa e paga depois; sem isso o dono planeja com
/// dinheiro que ainda não chegou — o erro que mais quebra loja pequena.
model FormaRecebimento {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  forma     FormaPagamento
  /// Pontos-base: 349 = 3,49% por venda.
  taxaBps   Int            @default(0)
  /// Dias corridos até o dinheiro cair. Dinheiro e Pix são 0; crédito costuma
  /// ser 30.
  prazoDias Int            @default(0)

  @@unique([lojaId, forma])
}

model ProdutoLoja {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  nome          String
  codigoBarras  String?
  precoCentavos Int     @default(0)
  /// Quanto custou para comprar. Fica em zero até a fase de estoque; sem ele a
  /// margem não é calculada, e margem estimada é pior que margem ausente.
  custoCentavos Int     @default(0)
  ativo         Boolean @default(true)

  /// Exigido pela nota fiscal (NCM = código da mercadoria perante a Receita).
  /// Fica opcional aqui porque a venda sem nota não precisa dele — só passa a
  /// travar a emissão, não o cadastro do produto.
  ncm String?

  criadoEm DateTime @default(now())

  itens      ItemVenda[]
  movimentos MovimentoEstoque[]

  @@unique([lojaId, codigoBarras])
  @@index([lojaId, nome])
}

/// Cliente da loja. Nome e telefone bastam.
///
/// Entra já na primeira fase por causa do fiado: dívida sem saber de quem não
/// serve para cobrar, que é justamente para o que o caderno é usado hoje.
model ClienteLoja {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  nome     String
  telefone String?
  criadoEm DateTime @default(now())

  vendas VendaLoja[]

  @@index([lojaId, nome])
}

model Caixa {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  abertoEm  DateTime  @default(now())
  fechadoEm DateTime?

  /// Troco deixado na gaveta na abertura.
  aberturaCentavos            Int  @default(0)
  /// O que o dono contou na gaveta ao fechar. Guardado como ele informou, sem
  /// ajuste: a diferença para o esperado é justamente o que ele precisa ver.
  fechamentoInformadoCentavos Int?

  vendas   VendaLoja[]
  sangrias SangriaCaixa[]

  @@index([lojaId, abertoEm])
}

/// Dinheiro tirado da gaveta durante o expediente (depósito, pagamento, troco).
model SangriaCaixa {
  id      String @id @default(cuid())
  caixaId String
  caixa   Caixa  @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  valorCentavos Int
  motivo        String?
  criadoEm      DateTime @default(now())
}

model VendaLoja {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  caixaId String?
  caixa   Caixa?  @relation(fields: [caixaId], references: [id])

  clienteId String?
  cliente   ClienteLoja? @relation(fields: [clienteId], references: [id])

  /// Sequencial por loja, para o dono e o cliente falarem do mesmo pedido.
  numero Int

  /// Soma dos itens menos o desconto. Gravado porque o preço do produto muda
  /// com o tempo e a venda de ontem tem de continuar valendo o de ontem.
  totalCentavos    Int @default(0)
  descontoCentavos Int @default(0)

  cancelada   Boolean   @default(false)
  canceladaEm DateTime?
  observacao  String?

  criadoEm DateTime @default(now())

  itens      ItemVenda[]
  pagamentos PagamentoVenda[]
  notaFiscal NotaFiscalVenda?

  @@unique([lojaId, numero])
  @@index([lojaId, criadoEm])
}

/// Nota fiscal (NFC-e) de uma venda, emitida por API de terceiro.
///
/// Emissão não é obrigatória para todo MEI hoje (ver docs/TINO-MEI.md) — por
/// isso é registro à parte da venda, não campo dela: a maioria das vendas vive
/// sem nunca ter uma.
///
/// Guarda o XML retornado, nunca o recria: é o documento fiscal de verdade, e
/// recalcular por conta própria divergiria do que a SEFAZ efetivamente
/// autorizou.
model NotaFiscalVenda {
  id      String    @id @default(cuid())
  vendaId String    @unique
  venda   VendaLoja @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  status StatusNotaFiscal @default(PENDENTE)

  chaveAcesso    String?
  numero         Int?
  serie          Int?
  xml            String?
  /// Preenchido só quando REJEITADA — é o que a tela mostra para o lojista
  /// saber o que corrigir antes de tentar de novo.
  motivoRejeicao String?

  emitidaEm   DateTime?
  canceladaEm DateTime?
  criadoEm    DateTime  @default(now())

  @@index([vendaId])
  @@index([status])
}

enum StatusNotaFiscal {
  PENDENTE
  EMITIDA
  REJEITADA
  CANCELADA
}

model ItemVenda {
  id      String    @id @default(cuid())
  vendaId String
  venda   VendaLoja @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  produtoId String?
  produto   ProdutoLoja? @relation(fields: [produtoId], references: [id])

  /// Copiada do produto na hora da venda. Se o produto for renomeado ou
  /// apagado depois, o histórico continua legível.
  descricao             String
  quantidade            Int    @default(1)
  precoUnitarioCentavos Int
  totalCentavos         Int

  @@index([vendaId])
}

/// Uma venda pode ser paga em mais de uma forma (metade Pix, metade dinheiro).
model PagamentoVenda {
  id      String    @id @default(cuid())
  vendaId String
  venda   VendaLoja @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  forma         FormaPagamento
  valorCentavos Int

  /// Taxa e líquido congelados no momento da venda. A taxa da maquininha muda
  /// com o tempo; recalcular depois faria a venda de março mudar de valor.
  taxaBps              Int @default(0)
  valorLiquidoCentavos Int

  /// Quando o dinheiro cai. Hoje para dinheiro e Pix, D+30 para crédito.
  previsaoRecebimentoEm DateTime
  /// Preenchido quando o dono confirma que caiu. Enquanto for null, o valor
  /// conta como a receber, nunca como saldo disponível.
  recebidoEm            DateTime?

  /// Número de parcelas no crédito parcelado. 1 nas demais formas.
  parcelas Int @default(1)

  @@index([vendaId])
  @@index([previsaoRecebimentoEm])
}

/// Movimento de estoque.
///
/// O saldo do produto é a soma dos movimentos, nunca um campo gravado. Campo
/// gravado e soma divergem no primeiro erro de gravação, e aí ninguém sabe em
/// qual acreditar — o mesmo motivo pelo qual o saldo da conta no Tino pessoal
/// também é derivado.
model MovimentoEstoque {
  id        String      @id @default(cuid())
  produtoId String
  produto   ProdutoLoja @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  tipo TipoMovimentoEstoque

  /// Sempre positiva. O sinal vem do tipo, não do número: quantidade negativa
  /// numa entrada seria uma saída disfarçada, impossível de auditar depois.
  quantidade Int

  /// Quanto custou a peça nesta entrada. Zero na saída, onde o custo relevante
  /// é o da entrada correspondente.
  custoUnitarioCentavos Int @default(0)

  /// Preenchido quando o movimento nasceu de uma venda do balcão.
  vendaId String?

  motivo   String?
  criadoEm DateTime @default(now())

  @@index([produtoId, criadoEm])
  @@index([vendaId])
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  /// Contagem física: o saldo passa a ser o informado, e a diferença fica
  /// registrada como ajuste em vez de sumir.
  AJUSTE
}

/// Conta que a loja paga para existir: aluguel, condomínio, fornecedor, luz.
///
/// Separada das despesas pessoais de propósito. Misturar o aluguel do box com o
/// aluguel de casa é o que faz o MEI achar que lucrou quando só girou dinheiro.
model ContaDaLoja {
  id     String @id @default(cuid())
  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  descricao     String
  categoria     CategoriaDaLoja @default(OUTRO)
  valorCentavos Int
  vencimento    DateTime

  paga   Boolean   @default(false)
  pagaEm DateTime?

  /// Marca a conta que se repete todo mês, para a próxima nascer sozinha.
  mensal Boolean @default(false)

  observacao String?
  criadoEm   DateTime @default(now())

  @@index([lojaId, vencimento])
  @@index([lojaId, paga])
}

enum CategoriaDaLoja {
  ALUGUEL
  CONDOMINIO
  FORNECEDOR
  ENERGIA
  MAQUININHA
  IMPOSTO
  FUNCIONARIO
  OUTRO
}

// ============================================================
// ASSINATURA E COBRANÇA
//
// Dois gateways ao mesmo tempo, Mercado Pago e Stripe, com o cliente
// escolhendo. Quem vende no Brasil precisa de Pix e boleto (Mercado Pago) e
// quem cobra fora precisa de cartão internacional (Stripe) — e o gateway que
// cai leva a receita junto, então ter o segundo é também o plano B.
//
// O status desta tabela nunca é escrito pela tela: só o webhook do provedor,
// depois de a assinatura do evento ser conferida, muda para ATIVA ou
// INADIMPLENTE. Confiar no retorno do navegador deixaria qualquer pessoa
// liberar a própria conta trocando a URL.
// ============================================================

model Assinatura {
  id        String  @id @default(cuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  provedor ProvedorPagamento
  status   StatusAssinatura  @default(TESTE)

  /// Código do plano em `src/lib/planos.ts` ("pessoal", "loja"). Texto e não
  /// enum porque plano é decisão comercial: criar um plano novo não pode
  /// exigir migration.
  planoId String
  ciclo   CicloCobranca @default(MENSAL)

  /// Preço congelado na contratação. O valor da tabela muda com reajuste, e
  /// quem já assinou continua pagando o que contratou até aceitar o novo.
  valorCentavos Int @default(0)

  /// Id da assinatura no provedor (preapproval_id ou sub_...). Nulo enquanto o
  /// checkout não voltou.
  idExterno String?

  /// Id do cliente no provedor, para reabrir o portal de cobrança sem criar
  /// um cadastro novo a cada visita.
  clienteExterno String?

  testeAteEm        DateTime?
  inicioEm          DateTime?
  proximaCobrancaEm DateTime?
  canceladaEm       DateTime?

  /// Último motivo de recusa informado pelo provedor. É o que a tela do usuário
  /// mostra em vez de "algo deu errado".
  motivoFalha String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cobrancas Cobranca[]

  @@unique([provedor, idExterno])
  @@index([status])
}

/// Uma cobrança concreta: o que o provedor tentou receber, e se recebeu.
///
/// Separada da assinatura porque falha de pagamento é histórico, não estado.
/// Guardar só o status atual apagaria a terceira tentativa recusada — que é
/// justamente o que o suporte precisa ver quando o cliente reclama.
model Cobranca {
  id           String     @id @default(cuid())
  assinaturaId String
  assinatura   Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  provedor  ProvedorPagamento
  /// Id do pagamento/fatura no provedor. Único por provedor: o mesmo evento
  /// reenviado não vira uma segunda linha de cobrança.
  idExterno String

  status        StatusCobranca @default(PENDENTE)
  valorCentavos Int
  motivoFalha   String?

  competencia String? // YYYY-MM da mensalidade paga
  pagaEm      DateTime?
  criadoEm    DateTime  @default(now())

  @@unique([provedor, idExterno])
  @@index([assinaturaId, criadoEm])
}

/// Evento de webhook já processado.
///
/// Os dois provedores reentregam o mesmo evento quando a resposta demora ou
/// falha, e o Stripe diz na documentação que a entrega é "pelo menos uma vez".
/// Sem esta trava, uma reentrega criaria a mesma cobrança duas vezes e o
/// faturamento do painel passaria a mentir.
model EventoWebhook {
  id        String            @id @default(cuid())
  provedor  ProvedorPagamento
  idEvento  String
  tipo      String
  recebidoEm DateTime         @default(now())

  @@unique([provedor, idEvento])
  @@index([recebidoEm])
}

// ============================================================
// SUPORTE E PARÂMETROS DO SISTEMA
// ============================================================

/// Chamado aberto pelo usuário de dentro do app.
///
/// A alternativa era um e-mail de suporte, que some na caixa de entrada e não
/// diz de qual conta veio. Aqui o chamado já nasce ligado ao usuário, então
/// quem responde vê a assinatura e o histórico de cobrança do mesmo lugar.
model Chamado {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo     TipoChamado   @default(DUVIDA)
  status   StatusChamado @default(ABERTO)
  mensagem String

  /// Rota em que a pessoa estava. Bug relatado sem a tela obriga a adivinhar.
  rota String?

  resposta    String?
  resolvidoEm DateTime?
  criadoEm    DateTime  @default(now())

  @@index([status, criadoEm])
  @@index([usuarioId])
}

/// Parâmetro global do produto, editável sem deploy.
///
/// Preço de plano e teto de juros são números que mudam por decisão de negócio
/// ou por lei, não por código. Enquanto viviam em constante, mudar o preço
/// exigia commit, build e deploy — e o valor divergia da propaganda no
/// intervalo. O valor fica como texto: cada leitor sabe se o seu é Int de
/// centavos, pontos-base ou palavra, e um campo por tipo daria três colunas
/// nulas em toda linha.
model ParametroSistema {
  chave     String @id
  valor     String
  descricao String?

  atualizadoEm DateTime @updatedAt
  atualizadoPor String?
}
