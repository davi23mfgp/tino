DATABASE_URL="postgresql://user:pass@localhost:5432/tino?schema=public"
# Conexao direta, sem pooler: usada so pelo `prisma migrate`.
# Em desenvolvimento e igual a DATABASE_URL.
DIRECT_URL="postgresql://user:pass@localhost:5432/tino?schema=public"

JWT_SECRET="troque-por-32-bytes-aleatorios"

# Assistente Tino — opcional. Sem chave, o assistente roda no motor de regras local.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Groq — opcional, e sao DUAS chaves de proposito.
#
# GROQ_API_KEY_AUDIO: so transcreve audio do WhatsApp/Telegram (Whisper). Os
# modelos Claude nao aceitam audio, entao e esta que faz o recado de voz virar
# lancamento. Sem ela, quem manda audio recebe um recado pedindo para escrever.
#
# GROQ_API_KEY: faz o Groq assumir TAMBEM as respostas do assessor, na frente
# do Claude. Deixe vazia se quiser a conversa no Claude e so o audio no Groq.
GROQ_API_KEY_AUDIO=""
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_MODELO_AUDIO="whisper-large-v3-turbo"

# Open Finance — agregador (Pluggy / Belvo / similar). Sem chaves, a tela
# `/conectar` diz "ainda nao configurado" e manda para o import de arquivo,
# que ja funciona. Nada e inventado e nenhuma conexao e fingida.
#
# Para ligar de verdade: crie a conta na Pluggy (https://pluggy.ai), pegue o
# par de chaves no painel deles e cole nas duas linhas abaixo. Criar conta e
# aceitar termos e acao de dinheiro — quem faz isso e o Davi, nao o agente.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Nomes antigos, ainda aceitos como alternativa aos PLUGGY_* acima.
OPEN_FINANCE_PROVIDER="sandbox"
OPEN_FINANCE_CLIENT_ID=""
OPEN_FINANCE_CLIENT_SECRET=""
OPEN_FINANCE_BASE_URL=""

# Captura rapida por WhatsApp — opcional, e o canal principal do assessor.
#
# Usa a Cloud API oficial da Meta, nao biblioteca de QR code: as nao oficiais
# funcionam mas violam os termos, e o numero banido seria o do cliente.
#
# Exige, e nao tem como contornar: um numero DEDICADO ao bot (ele para de
# funcionar no WhatsApp comum), conta na Meta Business com o numero verificado,
# e webhook em HTTPS publico — ou seja, so depois de publicado.
#
# WHATSAPP_TOKEN e WHATSAPP_PHONE_ID: Meta Business > WhatsApp > Configuracao da API
# WHATSAPP_VERIFY_TOKEN: voce inventa, e repete o mesmo valor ao cadastrar o
# webhook em https://SEU_ENDERECO/api/whatsapp/webhook
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET: Meta for Developers > App > Configuracoes > Basico >
# Chave secreta do app. Sem ela o webhook recusa toda mensagem (confere a
# assinatura X-Hub-Signature-256 para ninguem se passar por um cliente).
WHATSAPP_APP_SECRET=""
#
# WHATSAPP_MODELO_AVISO: nome do modelo aprovado pela Meta que carrega o aviso
# do vigia. Sem ele o Tino NAO fala primeiro — a parte de decidir o que dizer
# roda inteira e devolve o que teria mandado, sem mandar.
#
# Por que um modelo, e nao texto solto: quando a pessoa escreve, abre uma
# janela de 24h em que responder e livre e de graca. Passada a janela, texto
# solto e DESCARTADO em silencio pela Meta (a API responde 200 assim mesmo).
# Falar primeiro so funciona por modelo aprovado antes, e essa mensagem e
# cobrada — por volta de R$ 0,08 a R$ 0,25 cada, categoria utilidade.
WHATSAPP_MODELO_AVISO=""

# Captura rápida por Telegram — opcional.
# Crie o bot com @BotFather, e registre o webhook apontando para
# https://SEU_ENDERECO/api/telegram/webhook?segredo=SEU_SEGREDO
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SEGREDO=""

# ── Cobranca de assinatura ──────────────────────────────────────────────
# Os dois gateways sao opcionais e independentes. Sem chave, o botao daquele
# provedor aparece desabilitado com o motivo na tela, e o resto do app continua
# funcionando inteiro. Nunca comite chave de producao aqui.

# Mercado Pago — credenciais da aplicacao em
# https://www.mercadopago.com.br/developers/panel/app
# ACCESS_TOKEN comeca com TEST- no ambiente de teste e com APP_USR- em producao.
MERCADO_PAGO_ACCESS_TOKEN=""
# Assinatura secreta do webhook, gerada ao cadastrar a notificacao no painel.
# Sem ela o endpoint recusa todo evento — que e o comportamento desejado.
MERCADO_PAGO_WEBHOOK_SECRET=""

# Stripe — https://dashboard.stripe.com/apikeys
# sk_test_... em teste, sk_live_... em producao.
STRIPE_SECRET_KEY=""
# whsec_... — gerado ao criar o endpoint em Developers > Webhooks apontando para
# https://SEU_ENDERECO/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ── Notificação que volta sozinha (web push) ──────────────────────────────
# Sem fornecedor: o par VAPID identifica este servidor e o navegador entrega
# de graça. Gere o seu com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A pública vai para o cliente (é pública mesmo, só identifica o servidor);
# a privada, nunca. Sem as duas, o atalho de lançar continua funcionando —
# só não volta sozinho.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Exigência do padrão: como o serviço de push fala com o dono do servidor.
VAPID_ASSUNTO="mailto:voce@exemplo.com"

# Protege /api/cron/lembrete. Sem isso, qualquer um chamaria a rota em laço e
# viraria spam no celular de todo mundo.
CRON_SECRET=""
