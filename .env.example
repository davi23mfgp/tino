DATABASE_URL="postgresql://user:pass@localhost:5432/tino?schema=public"
# Conexao direta, sem pooler: usada so pelo `prisma migrate`.
# Em desenvolvimento e igual a DATABASE_URL.
DIRECT_URL="postgresql://user:pass@localhost:5432/tino?schema=public"

JWT_SECRET="troque-por-32-bytes-aleatorios"

# Assistente Tino — opcional. Sem chave, o assistente roda no motor de regras local.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Open Finance — agregador (Pluggy / Belvo / similar). Sem chaves, a tela
# `/conectar` diz "ainda nao configurado" e manda para o import de arquivo,
# que ja funciona. Nada e inventado e nenhuma conexao e fingida.
#
# Para ligar de verdade: crie a conta na Pluggy (https://pluggy.ai), pegue o
# par de chaves no painel deles e cole nas duas linhas abaixo. Criar conta e
# aceitar termos e acao de dinheiro — quem faz isso e o Davi, nao o agente.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Nomes antigos, ainda aceitos como alternativa aos PLUGGY_* acima.
OPEN_FINANCE_PROVIDER="sandbox"
OPEN_FINANCE_CLIENT_ID=""
OPEN_FINANCE_CLIENT_SECRET=""
OPEN_FINANCE_BASE_URL=""

# Captura rápida por Telegram — opcional.
# Crie o bot com @BotFather, e registre o webhook apontando para
# https://SEU_ENDERECO/api/telegram/webhook?segredo=SEU_SEGREDO
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SEGREDO=""

# ── Cobranca de assinatura ──────────────────────────────────────────────
# Os dois gateways sao opcionais e independentes. Sem chave, o botao daquele
# provedor aparece desabilitado com o motivo na tela, e o resto do app continua
# funcionando inteiro. Nunca comite chave de producao aqui.

# Mercado Pago — credenciais da aplicacao em
# https://www.mercadopago.com.br/developers/panel/app
# ACCESS_TOKEN comeca com TEST- no ambiente de teste e com APP_USR- em producao.
MERCADO_PAGO_ACCESS_TOKEN=""
# Assinatura secreta do webhook, gerada ao cadastrar a notificacao no painel.
# Sem ela o endpoint recusa todo evento — que e o comportamento desejado.
MERCADO_PAGO_WEBHOOK_SECRET=""

# Stripe — https://dashboard.stripe.com/apikeys
# sk_test_... em teste, sk_live_... em producao.
STRIPE_SECRET_KEY=""
# whsec_... — gerado ao criar o endpoint em Developers > Webhooks apontando para
# https://SEU_ENDERECO/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
