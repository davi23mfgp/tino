{
  "name": "Tino · seu contador pessoal",
  "short_name": "Tino",
  "description": "Contas, dívidas, metas e projeção de caixa em um lugar só.",
  "start_url": "/painel",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b1d24",
  "theme_color": "#1b1d24",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icones/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icones/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icones/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Anotar um gasto",
      "short_name": "Anotar",
      "url": "/lancar"
    },
    {
      "name": "Ditar um gasto",
      "short_name": "Ditar",
      "url": "/lancar?modo=voz"
    },
    {
      "name": "Pagar uma conta do mês",
      "short_name": "Pagar conta",
      "url": "/recorrencias"
    },
    {
      "name": "Conferir compras",
      "short_name": "Conferir",
      "url": "/capturas"
    }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "endereco",
      "files": [
        { "name": "arquivo", "accept": ["application/pdf", "text/csv", "application/x-ofx", ".pdf", ".csv", ".ofx"] }
      ]
    }
  }
}
